PORT=3000

# ===========================
# DATABASE CONFIGURATION
# ===========================
# Set true in development to speed up Docker builds and enable future test/mock wiring
APP_DEVELOPMENT=false

# Comma-separated origins allowed to call the API from browsers
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Full database connection string used by the application
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://youruser:yourpassword@db:5432/myfittracker_db

# PostgreSQL credentials (used by docker-compose or local setup)
POSTGRES_USER=youruser
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=myfittracker_db


# ===========================
# JWT CONFIGURATION
# ===========================
# Secret key used to sign access tokens (keep this secure)
SECRET_ACCESS_KEY=your_access_secret_key

# Secret key used to sign refresh tokens (keep this secure)
SECRET_REFRESH_KEY=your_refresh_secret_key

# Access token expiration time in minutes
ACCESS_MINUTES=60

# Refresh token expiration time in days
REFRESH_DAYS=30

# Google OAuth client ID used to validate id_tokens sent by the frontend
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com


# ===========================
# MAIL SERVICE CONFIGURATION
# ===========================
# Emails are sent through the Resend HTTP API (https://resend.com), NOT SMTP.
# Render (production host) blocks outbound SMTP, so the SMTP transport
# (LettreSmtpService) exists only as an alternative for other environments.
# The SMTP_* variable names are kept for compatibility with existing deploys:
#   - SMTP_PASS holds the Resend API key
#   - SMTP_FROM is the sender address (must be a domain verified in Resend)
#   - SMTP_HOST/PORT/SECURE/USER are still required by the env loader but are
#     only used by the (inactive) SMTP transport

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=unused_with_resend

# Resend API key (used as the mail service credential)
SMTP_PASS=re_your_resend_api_key

# Sender address for outgoing emails
SMTP_FROM=you_at_yourdomain.com

# ===========================
# BUCKET / OBJECT STORAGE (Cloudflare R2)
# ===========================
# Access key ID for the bucket service
R2_ACCESS_KEY_ID=your_r2_access_key_id

# Secret access key for the bucket service
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Bucket name where files will be stored
R2_BUCKET_NAME=myfittracker-bucket

# S3-compatible endpoint for Cloudflare R2
# Format: https://<account_id>.r2.cloudflarestorage.com
R2_S3_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Public base URL used to access stored files (CDN or custom domain)
R2_PUBLIC_BASE_URL=https://cdn.myfittracker.com.br
