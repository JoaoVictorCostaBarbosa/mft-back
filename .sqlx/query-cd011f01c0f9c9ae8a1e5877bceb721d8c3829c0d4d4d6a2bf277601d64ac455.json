  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n              wp.id,\n              wp.user_id,\n              wp.name,\n              wp.created_at,\n              wp.updated_at,\n              wp.deleted_at\n            FROM current_workout_plan cwp\n            JOIN workout_plan wp\n              ON wp.id = cwp.workout_plan_id\n            WHERE cwp.user_id = $1\n              AND wp.deleted_at IS NULL;\n            ",
