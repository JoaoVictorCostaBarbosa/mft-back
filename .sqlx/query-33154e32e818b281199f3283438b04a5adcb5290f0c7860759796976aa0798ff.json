{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                wt.id,\n                wt.user_id,\n                wt.name,\n                wt.created_at,\n                wt.updated_at,\n                wt.deleted_at\n            FROM workout_template wt\n            JOIN workout_template_in_plan wtp\n                ON wt.id = wtp.workout_template_id\n            WHERE wtp.workout_plan_id = $1\n                AND wt.deleted_at IS NULL\n            ",
