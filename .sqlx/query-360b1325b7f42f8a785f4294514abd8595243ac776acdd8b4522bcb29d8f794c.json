  "query": "\n            SELECT\n                id,\n                user_id,\n                name,\n                exercise_type AS \"exercise_type: ExerciseTypeDb\",\n                equipment     AS \"equipment: EquipmentDb\",\n                muscle_group  AS \"muscle_group: MuscleGroupDb\",\n                created_at,\n                deleted_at\n            FROM exercise\n            WHERE deleted_at IS NULL\n                AND id = $1\n            ",
